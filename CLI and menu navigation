def display_main_menu():
    """Renders the main interactive options available to the user."""
    print("\n" + "=" * 45)
    print("      EXPENSE TRACKER & BUDGET MANAGER")
    print("=" * 45)
    print(" [1] Add a New Transaction")
    print(" [2] View All Transactions")
    print(" [3] View Category Spending Summary")
    print(" [4] Filter Transactions")
    print(" [5] Calculate Total Expenses")
    print(" [6] Save & Exit Program")
    print("-" * 45)

def prompt_user_input(prompt_text, expected_type=str):
    """Safely accepts and parses user responses with error handling."""
    while True:
        try:
            user_input = input(prompt_text).strip()
            
            if expected_type == int:
                return int(user_input)
            elif expected_type == float:
                return float(user_input)
            elif expected_type == str:
                if not user_input:
                    print("Input cannot be empty. Please try again.")
                    continue
                return user_input
            else:
                return user_input
                
        except ValueError:
            print(f"Invalid input! Expected a valid {expected_type.__name__}. Please try again.")


